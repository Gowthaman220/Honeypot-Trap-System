# Backend Dockerfile for Honeypot Trap System
FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source code and seed scripts
COPY backend/app /app/app
COPY scripts /app/scripts
COPY .env.example /app/.env

# Create data directory
RUN mkdir -p /app/data

# Environment configuration defaults
ENV PYTHONUNBUFFERED=1
ENV DATABASE_URL="sqlite:////app/data/honeypot.db"

# Expose API and honeypot listener ports
# 8000: Admin REST API & WebSocket
# 2222: Safe SSH Honeypot
# 8080: Safe HTTP Honeypot
# 2121: Safe FTP Honeypot
# 9999: Generic TCP Listener
EXPOSE 8000 2222 8080 2121 9999

# Run startup initialization and launch uvicorn
CMD ["sh", "-c", "python -m app.core.init_db && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
