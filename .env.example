# Honeypot Trap System - Environment Configuration
APP_NAME="Honeypot Trap System"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="honey-secret-key-change-in-production-super-safe-32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Use SQLite for default zero-setup local deployment, or PostgreSQL for production:
DATABASE_URL="sqlite:///./honeypot.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/honeypot_db"

# Admin Initial Account
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="adminpassword123"

# Honeypot Services Configuration
SSH_HONEYPOT_ENABLED=true
SSH_HONEYPOT_PORT=2222

HTTP_HONEYPOT_ENABLED=true
HTTP_HONEYPOT_PORT=8080

FTP_HONEYPOT_ENABLED=true
FTP_HONEYPOT_PORT=2121

TCP_HONEYPOT_ENABLED=true
TCP_HONEYPOT_PORT=9999

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Alerting Configuration
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=""
